{
  "name": "kunwu-admin",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.15.9",
  "scripts": {
    "dev": "next dev --turbopack -H 127.0.0.1 -p 3100",
    "build": "KUNWU_ADMIN_DIST_DIR=.next-build next build",
    "start": "KUNWU_ADMIN_DIST_DIR=.next-build next start -H 127.0.0.1 -p 3100",
    "db:up": "docker compose up -d --wait mysql",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx tools/db-migrate.ts",
    "db:seed": "tsx tools/db-seed.ts",
    "db:setup": "pnpm db:up && pnpm db:migrate && pnpm db:seed && pnpm db:import:godot",
    "db:studio": "drizzle-kit studio",
    "db:check": "tsx tools/db-check.ts",
    "db:import:godot": "tsx tools/import-godot-config.ts",
    "import:stories": "node tools/import-story-drafts.mjs",
    "audit:stories": "node tools/audit-story-import.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "pnpm audit:stories && pnpm typecheck && pnpm lint && pnpm build",
    "test:resources": "node --import tsx --test tests/resources/*.test.ts",
    "test:resources:unit": "node --import tsx --test tests/resources/settle.test.ts tests/resources/single-cycle.test.ts",
    "test:resources:db": "node --import tsx --test tests/resources/database.test.ts",
    "resources:setup": "node --import tsx tools/resource-development.ts",
    "resources:dev": "KUNWU_ALLOW_LOCAL_RESOURCE_LOGIN=1 next dev --turbopack -H 127.0.0.1 -p 3100",
    "resources:start": "KUNWU_ALLOW_LOCAL_RESOURCE_LOGIN=1 KUNWU_ADMIN_DIST_DIR=.next-build next start -H 127.0.0.1 -p 3100",
    "test:resources:godot": "node --import tsx tools/test-resource-godot.ts",
    "test:items": "node --conditions=react-server --import tsx --test tests/items/*.test.ts",
    "items:setup": "node --conditions=react-server --import tsx tools/item-development.ts",
    "cultivators:setup": "node --conditions=react-server --import tsx tools/cultivator-development.ts",
    "test:cultivators": "node --conditions=react-server --import tsx --test tests/cultivators/*.test.ts",
    "items:sync": "node --conditions=react-server --import tsx tools/sync-item-content.ts",
    "skills:sync": "node --conditions=react-server --import tsx tools/sync-skill-content.ts",
    "test:skills": "node --conditions=react-server --import tsx --test tests/skills/*.test.ts",
    "world:sync": "node --conditions=react-server --import tsx tools/sync-world-content.ts",
    "test:onboarding": "node --conditions=react-server --import tsx --test tests/onboarding/*.test.ts",
    "map01:sync": "node --conditions=react-server --import tsx tools/sync-map01-runtime.ts",
    "map01:export-test": "node --conditions=react-server --import tsx tools/export-map01-runtime-test.ts",
    "map01:loop:sync": "node --conditions=react-server --import tsx tools/sync-map01-loop.ts",
    "test:encounters": "node --conditions=react-server --import tsx --test tests/encounters/*.test.ts",
    "maps:sync:map01": "node --conditions=react-server --import tsx tools/sync-map01-map.ts",
    "test:maps": "node --conditions=react-server --import tsx --test tests/maps/*.test.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.23.3",
    "next": "^15.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.4.6",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2"
  }
}
